# GitHub App Profile Template
# Copy this file to app-profile for each agent and fill in the values
#
# Location: ~/.config/peer-coordination/<agent>-app-profile
#
# Example:
#   mkdir -p ~/.config/peer-coordination
#   cp config/app-profile.template ~/.config/peer-coordination/codex-app-profile
#
# Format: KEY=value (no surrounding quotes; the parser does not strip them).
# Values starting/ending with whitespace are not supported.

# App ID from GitHub App settings (numeric ID)
APP_ID=

# Installation ID from the installed app (numeric ID)
INSTALLATION_ID=

# Path to the private key PEM file (mode 600; never commit)
# Generate: GitHub App settings → Private keys → Generate a private key
PRIVATE_KEY_PATH=
