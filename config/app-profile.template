# GitHub App Profile Template
# Copy this file to ~/.config/peer-coordination/<agent>-app-profile and fill in
# the values for the matching bot identity.
#
# Example:
#   mkdir -p ~/.config/peer-coordination
#   cp config/app-profile.template ~/.config/peer-coordination/vigil-app-profile
#
# Format: KEY=value

# GitHub App ID (numeric)
APP_ID=

# Installation ID for the repo-local app install (numeric)
INSTALLATION_ID=

# Path to the private key PEM file (mode 600; never commit)
PRIVATE_KEY_PATH=
